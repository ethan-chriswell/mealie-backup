# URL to your Mealie instance (no trailing slash)
MEALIE_URL=http://mealie.yourdomain.com

# API key created under Mealie → Admin → Tokens
MEALIE_API_KEY=your_mealie_api_key

# Local backup directory inside container is always /app/backups,
# but you can mount it wherever you want externally
BACKUP_OUTPUT_DIR=./backups